                    <ui:VisualElement name="panel-1" class="pn-panel pn-panel-hidden">
                        <ui:Label text="Family history of schizophrenia — father treated in various inpatient facilities for many years" class="pn-list-item" />
                        <ui:Label text="Hearing impairment due to work-related noise exposure; uses a single hearing aid" class="pn-list-item" />
                        <ui:Label text="PTSD following military deployment to Lebanon during the 1980s; recovered following treatment but medically discharged from the Army" class="pn-list-item" />
                        <ui:Label text="Joint inflammation in arms/hands causing pain, stiffness and difficulty with fine motor functions — uses adaptive tools at home" class="pn-list-item" />
                        <ui:Label text="Recent cataract surgery" class="pn-list-item" />
                    </ui:VisualElement>
                    <ui:VisualElement name="panel-2" class="pn-panel pn-panel-hidden">
                        <ui:Label text="Friend contacted by phone first — concerned about fever when visiting Arthur at home" class="pn-list-item" />
                        <ui:Label text="Examined in Minor Injuries Dept; subsequently admitted for treatment of infection via IV antibiotics" class="pn-list-item" />
                        <ui:Label text="Eye infection - upon questioning, patient admitted use of post-surgical eye drops was sporadic due to fine motor control issues caused by hand stiffness" class="pn-list-item" />
                    </ui:VisualElement>
