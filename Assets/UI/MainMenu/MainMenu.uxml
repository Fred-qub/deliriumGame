<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="MainMenu.uss" />

    <!--
        MainMenu.uxml — Misperception
        Attach to a UIDocument component on the UIManager GameObject in MainMenu scene.
        Companion stylesheet: MainMenu.uss
        Controller script:   MainMenuController.cs
    -->

    <ui:VisualElement name="root" class="root">

        <!-- Atmospheric overlay layers (sit over the live 3D camera) -->
        <ui:VisualElement name="vignette"   class="vignette"   picking-mode="Ignore" />
        <ui:VisualElement name="scanlines"  class="scanlines"  picking-mode="Ignore" />
        <ui:VisualElement name="top-stripe" class="top-stripe" picking-mode="Ignore" />
        <ui:VisualElement name="bot-stripe" class="bot-stripe" picking-mode="Ignore" />

        <!-- Two-column layout -->
        <ui:VisualElement name="screen" class="screen">

            <!-- ── LEFT COLUMN: identity + emotional hook ── -->
            <ui:VisualElement name="col-left" class="col-left">

                <ui:Label name="hook-quote"
                    class="hook-quote"
                    text="&quot;He keeps saying there&apos;s a strange man in the room.&quot;" />

                <!-- Game title: "Mis" light + "perception" bold amber -->
                <ui:VisualElement name="title-row" class="title-row">
                    <ui:Label name="title-mis"        class="title-mis"        text="Mis" />
                    <ui:Label name="title-perception" class="title-perception" text="perception" />
                </ui:VisualElement>

                <ui:Label name="hook-body"
                    class="hook-body"
                    text="An elderly patient is saying things that don&apos;t add up. He&apos;s frightened and not making sense. He may not be able to tell you what&apos;s wrong — but the truth is there, if you know how to look for it." />

                <ui:Label name="mystery-body"
                    class="mystery-body"
                    text="Something just isn&apos;t right with the patient. The staff have noticed. His family have noticed, too. But no one has been able to say what — or why. Can you help Arthur before it&apos;s too late?" />

                <!-- Patient identity pill -->
                <ui:VisualElement name="patient-pill" class="patient-pill">
                    <ui:VisualElement name="patient-dot" class="patient-dot" />
                    <ui:VisualElement class="patient-info">
                        <ui:Label class="patient-name" text="Arthur Roberts, 70" />
                        <ui:Label class="patient-meta" text="GENERAL MEDICAL WARD  ·  INPATIENT - DAY 2  ·  EYE INFECTION" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
            <!-- /col-left -->

            <!-- ── RIGHT COLUMN: action panel ── -->
            <ui:VisualElement name="col-right" class="col-right">
                <ui:VisualElement name="panel" class="panel">

                    <ui:VisualElement class="panel-accent" />

                    <ui:VisualElement class="panel-header">
                        <ui:Label class="panel-eyebrow" text="Module 01  ·  Misperception" />
                        <ui:Label class="panel-title"   text="Begin your shift" />
                    </ui:VisualElement>

                    <!-- Objectives: dramatic questions, not learning outcomes -->
                    <ui:VisualElement class="objectives">

                        <ui:VisualElement class="obj-row">
                            <ui:Label class="obj-num"  text="01" />
                            <ui:Label class="obj-text" text="A patient is confused and distressed. What do you do first?" />
                        </ui:VisualElement>

                        <ui:VisualElement class="obj-row">
                            <ui:Label class="obj-num"  text="02" />
                            <ui:Label class="obj-text" text="He&apos;s telling you something. It doesn&apos;t make sense — or does it?" />
                        </ui:VisualElement>

                        <ui:VisualElement class="obj-row obj-row-last">
                            <ui:Label class="obj-num"  text="03" />
                            <ui:Label class="obj-text" text="One decision will help him. Another will make things significantly worse." />
                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- Context tags -->
                    <ui:VisualElement class="context-strip">

                        <ui:VisualElement class="ctx-tag">
                            <ui:Label class="ctx-label" text="YOUR ROLE" />
                            <ui:Label class="ctx-val"   text="Clinician" />
                        </ui:VisualElement>

                        <ui:VisualElement class="ctx-tag">
                            <ui:Label class="ctx-label" text="DURATION" />
                            <ui:Label class="ctx-val"   text="~15 min" />
                        </ui:VisualElement>

                        <ui:VisualElement class="ctx-tag">
                            <ui:Label class="ctx-label" text="PERSPECTIVES" />
                            <ui:Label class="ctx-val"   text="2 POV" />
                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- Action buttons -->
                    <ui:VisualElement class="btn-group">

                        <ui:Button name="btn-start" class="btn btn-primary">
                            <ui:VisualElement class="btn-inner">
                                <ui:Label class="btn-label" text="Enter the ward" />
                                <ui:Label class="btn-arrow" text="→" />
                            </ui:VisualElement>
                        </ui:Button>

                        <ui:Button name="btn-options" class="btn btn-secondary">
                            <ui:VisualElement class="btn-inner">
                                <ui:Label class="btn-label" text="Options" />
                                <ui:Label class="btn-arrow" text="⚙" />
                            </ui:VisualElement>
                        </ui:Button>

                        <ui:Button name="btn-about" class="btn btn-secondary btn-about-last">
                            <ui:VisualElement class="btn-inner">
                                <ui:Label class="btn-label" text="About this simulation" />
                                <ui:Label class="btn-arrow" text="↗" />
                            </ui:VisualElement>
                        </ui:Button>

                    </ui:VisualElement>

                    <ui:VisualElement class="panel-footer">
                        <ui:Label class="panel-footer-text" text="Educational use only  ·  Not clinical guidance" />
                        <ui:Label class="panel-version"     text="v1.0.0" />
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
            <!-- /col-right -->

        </ui:VisualElement>
        <!-- /screen -->

        <!-- About modal (hidden by default) -->
        <ui:VisualElement name="modal-overlay" class="modal-overlay">

            <ui:VisualElement name="modal-card" class="modal-card">

                <ui:VisualElement class="panel-accent" />

                <ui:VisualElement class="modal-header">
                    <ui:Label class="modal-title" text="About this simulation" />
                    <ui:Button name="modal-close" class="modal-close" text="✕" />
                </ui:VisualElement>

                <ui:Label class="modal-body"
                    text="Misperception is an interactive simulation designed to support healthcare professionals in understanding how patients experience a ward environment — and how clinical decisions shape that experience.&#10;&#10;Complete both perspectives to unlock evidence-based learning tips and guidance.&#10;&#10;This simulation is for educational purposes only and does not constitute clinical advice." />

                <ui:VisualElement class="modal-footer">
                    <ui:Button name="modal-ok" class="btn btn-primary modal-ok-btn">
                        <ui:VisualElement class="btn-inner">
                            <ui:Label class="btn-label" text="Close" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>
        <!-- /about-modal -->

        <!-- Options modal (hidden by default) -->
        <ui:VisualElement name="options-modal-overlay" class="modal-overlay">

            <ui:VisualElement name="options-modal-card" class="modal-card">

                <ui:VisualElement class="panel-accent" />

                <ui:VisualElement class="modal-header">
                    <ui:Label class="modal-title" text="Options" />
                    <ui:Button name="options-modal-close" class="modal-close" text="✕" />
                </ui:VisualElement>

                <ui:ScrollView name="options-scroll-body" class="options-scroll-body"
                               vertical-scroller-visibility="Auto"
                               horizontal-scroller-visibility="Hidden">

                <!-- ── Accessibility section ── -->
                <ui:VisualElement class="options-section">

                    <ui:Label class="options-section-label" text="ACCESSIBILITY" />

                    <!-- Colour Blindness Accommodation selector -->
                    <ui:VisualElement class="options-row options-row-col">
                        <ui:Label class="options-row-title" text="Colour blindness accommodation" />
                        <ui:Label class="options-row-desc"  text="Alters important visual elements to assist individuals with colour vision deficiency" />
                        <ui:VisualElement class="options-btn-group">
                            <ui:Button name="outline-btn-standard"     class="options-btn" text="STANDARD" />
                            <ui:Button name="outline-btn-protanopia"   class="options-btn" text="PROTANOPIA" />
                            <ui:Button name="outline-btn-deuteranopia" class="options-btn" text="DEUTERANOPIA" />
                            <ui:Button name="outline-btn-tritanopia"   class="options-btn" text="TRITANOPIA" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Content warnings — combined phobia section -->
                    <ui:VisualElement class="options-row options-row-col">
                        <ui:Label class="options-row-title" text="Content warnings" />
                        <ui:VisualElement class="options-phobia-rows">
                            <ui:VisualElement class="options-row options-phobia-row">
                                <ui:VisualElement class="options-row-text">
                                    <ui:Label class="options-row-title" text="Musophobia mode" />
                                    <ui:Label class="options-row-desc"  text="Toggle on to remove rodents" />
                                </ui:VisualElement>
                                <ui:Toggle name="toggle-musophobia" class="options-toggle" />
                            </ui:VisualElement>
                            <ui:VisualElement class="options-row options-phobia-row">
                                <ui:VisualElement class="options-row-text">
                                    <ui:Label class="options-row-title" text="Ophidiophobia mode" />
                                    <ui:Label class="options-row-desc"  text="Toggle on to remove serpents" />
                                </ui:VisualElement>
                                <ui:Toggle name="toggle-ophidiophobia" class="options-toggle" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Additional Subtitles toggle -->
                    <ui:VisualElement class="options-row">
                        <ui:VisualElement class="options-row-text">
                            <ui:Label class="options-row-title" text="Additional subtitles" />
                            <ui:Label class="options-row-desc"  text="Displays subtitles for some audio events" />
                        </ui:VisualElement>
                        <ui:Toggle name="toggle-subtitles" class="options-toggle" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- ── Controls section ── -->
                <ui:VisualElement class="options-section">

                    <ui:Label class="options-section-label" text="CONTROLS" />

                    <!-- Crosshair size selector -->
                    <ui:VisualElement class="options-row options-row-col">
                        <ui:Label class="options-row-title" text="Crosshair size" />
                        <ui:Label class="options-row-desc"  text="Sets the size of the crosshair" />
                        <ui:VisualElement class="options-btn-group">
                            <ui:Button name="crosshair-btn-small"  class="options-btn" text="SMALL" />
                            <ui:Button name="crosshair-btn-medium" class="options-btn" text="MEDIUM" />
                            <ui:Button name="crosshair-btn-large"  class="options-btn" text="LARGE" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Crosshair colour selector -->
                    <ui:VisualElement class="options-row options-row-col">
                        <ui:Label class="options-row-title" text="Crosshair colour" />
                        <ui:Label class="options-row-desc"  text="Sets the colour of the crosshair" />
                        <ui:VisualElement class="options-btn-group">
                            <ui:Button name="crosshairColour-btn-white"  class="options-btn" text="WHITE" />
                            <ui:Button name="crosshairColour-btn-red"    class="options-btn" text="RED" />
                            <ui:Button name="crosshairColour-btn-blue"   class="options-btn" text="BLUE" />
                            <ui:Button name="crosshairColour-btn-yellow" class="options-btn" text="YELLOW" />
                            <ui:Button name="crosshairColour-btn-orange" class="options-btn" text="ORANGE" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- ── Simulation section ── -->
                <ui:VisualElement class="options-section options-section-last">

                    <ui:Label class="options-section-label" text="SIMULATION" />

                    <!-- Time of day selector -->
                    <ui:VisualElement class="options-row options-row-col">
                        <ui:Label class="options-row-title" text="Time of day" />
                        <ui:Label class="options-row-desc"  text="Sets the ward lighting and atmosphere" />
                        <ui:VisualElement class="options-btn-group">
                            <ui:Button name="tod-btn-morning"   class="options-btn" text="9 AM" />
                            <ui:Button name="tod-btn-afternoon" class="options-btn" text="4 PM" />
                            <ui:Button name="tod-btn-night"     class="options-btn" text="11 PM" />
                            <ui:Button name="tod-btn-actual"    class="options-btn" text="Actual time" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

                </ui:ScrollView>

                <ui:VisualElement class="modal-footer">
                    <ui:Button name="options-modal-ok" class="btn btn-primary modal-ok-btn">
                        <ui:VisualElement class="btn-inner">
                            <ui:Label class="btn-label" text="Save &amp; close" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>
        <!-- /options-modal -->

    </ui:VisualElement>
    <!-- /root -->

</ui:UXML>
