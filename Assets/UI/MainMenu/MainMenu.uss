/*
    MainMenu.uss — Misperception
    Palette:   TipsScene navy + amber (#E67E00) + teal (#4A9B8E)
    Fonts:     IBM Plex Sans via direct TTF url() reference.
                 -unity-font-definition: none;
                 -unity-font: url("../../Fonts/IBMPlexSans-Regular.ttf");
               Path is relative to this file at Assets/UI/MainMenu/MainMenu.uss
    Notes:     USS does not support rgba() in border-color; closest solid used.
               Linear gradients not supported; accent bars use solid rgb(0, 94, 184).
               backdrop-filter not supported in Unity 6000.1.x UI Toolkit.
*/

/* ── Root — sets default font for all children ───────────────── */
.root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgba(0,0,0,0);
    background-image: url("project://database/Assets/UI/MainMenu/MainMenuBackground.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-font-definition: none;
    -unity-font: url("../../Fonts/IBMPlexSans-Regular.ttf");
}

/* Bold elements — mirrors TipsScreen.uss pattern */
.panel-title,
.patient-name,
.stake-num,
.btn-label,
.modal-title,
.ctx-val,
.options-row-title {
    -unity-font-definition: none;
    -unity-font: url("../../Fonts/IBMPlexSans-SemiBold.ttf");
}

/* ── Atmosphere layers ───────────────────────────────────────── */

.vignette {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(13, 7, 32, 0.08);
}

.scanlines {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0,0,0,0);
    opacity: 0.0;
}

.top-stripe {
    position: absolute;
    left: 0; top: 0; right: 0;
    height: 3px;
    background-color: rgb(0, 94, 184);
}

.bot-stripe {
    position: absolute;
    left: 0; bottom: 0; right: 0;
    height: 1px;
    background-color: rgb(26, 60, 55);
}

/* ── Screen layout ───────────────────────────────────────────── */
.screen {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    padding-left: 56px;
    padding-right: 56px;
    padding-top: 0;
    padding-bottom: 48px;
    background-color: rgba(5, 12, 22, 0.55);
    border-radius: 4px;
    width: 65%;
    align-self: center;
    margin-top: 24px;
    margin-bottom: 84px;
}

/* ── Left column ─────────────────────────────────────────────── */
.col-left {
    flex: 1;
    flex-direction: column;
    max-width: 480px;
    padding-right: 56px;
}

.eyebrow {
    font-size: 10px;
    color: rgb(138, 171, 176);
    letter-spacing: 2px;
    margin-bottom: 22px;
    -unity-text-align: upper-left;
}

.hook-quote {
    font-size: 14px;
    -unity-font-style: italic;
    color: rgb(74, 155, 142);
    margin-bottom: 18px;
    white-space: normal;
    -unity-text-align: upper-left;
    opacity: 0.85;
}

/* Title split — "Mis" regular / "perception" semibold amber */
.title-row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 20px;
}

.title-mis {
    font-size: 58px;
    color: rgb(237, 242, 240);
    -unity-text-align: lower-left;
    margin-right: -3px;
}

.title-perception {
    -unity-font-definition: none;
    -unity-font: url("../../Fonts/IBMPlexSans-SemiBold.ttf");
    font-size: 58px;
    color: rgb(230, 126, 0);
    -unity-text-align: lower-left;
}

.hook-body {
    font-size: 13px;
    color: rgb(138, 171, 176);
    white-space: normal;
    -unity-text-align: upper-left;
    max-width: 390px;
    margin-bottom: 0;
}

/* ── Stakes strip ────────────────────────────────────────────── */
.stakes {
    flex-direction: row;
    align-items: stretch;
    margin-top: 30px;
    padding-top: 22px;
    border-top-width: 1px;
    border-top-color: rgb(74, 155, 142);
    margin-bottom: 0;
}

.stake {
    flex: 1;
    flex-direction: column;
    padding-right: 18px;
}

.stake-divider {
    width: 1px;
    background-color: rgb(74, 155, 142);
    margin-right: 18px;
    align-self: stretch;
}

.stake-num {
    font-size: 20px;
    color: rgb(230, 126, 0);
    -unity-text-align: upper-left;
    margin-bottom: 4px;
}

.stake-label {
    font-size: 11px;
    color: rgb(138, 171, 176);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* ── Patient pill ────────────────────────────────────────────── */
.patient-pill {
    flex-direction: row;
    align-items: center;
    margin-top: 26px;
    padding: 10px 16px;
    background-color: rgb(16, 38, 34);
    border-width: 1px;
    border-color: rgb(74, 155, 142);
    border-radius: 3px;
    align-self: flex-start;
}

.patient-dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background-color: rgb(74, 155, 142);
    margin-right: 10px;
    flex-shrink: 0;
}

.patient-info {
    flex-direction: column;
}

.patient-name {
    font-size: 13px;
    color: rgb(237, 242, 240);
    -unity-text-align: upper-left;
    margin-bottom: 2px;
}

.patient-meta {
    font-size: 10px;
    color: rgb(120, 170, 162);
    letter-spacing: 0.8px;
    -unity-text-align: upper-left;
}

/* ── Right column ────────────────────────────────────────────── */
.col-right {
    width: 336px;
    flex-shrink: 0;
    flex-direction: column;
}

/* ── Panel ───────────────────────────────────────────────────── */
.panel {
    flex-direction: column;
    background-color: rgba(10, 20, 36, 0.86);
    border-width: 1px;
    border-color: rgb(26, 55, 50);
    border-radius: 4px;
}

.panel-accent {
    height: 3px;
    background-color: rgb(0, 94, 184);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.panel-header {
    padding: 16px 22px 13px 22px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(20, 44, 40);
}

.panel-eyebrow {
    font-size: 9px;
    color: rgb(61, 90, 96);
    letter-spacing: 2px;
    -unity-text-align: upper-left;
    margin-bottom: 4px;
}

.panel-title {
    font-size: 16px;
    color: rgb(237, 242, 240);
    -unity-text-align: upper-left;
}

/* ── Objectives ──────────────────────────────────────────────── */
.objectives {
    flex-direction: column;
    padding: 13px 22px 11px 22px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(18, 38, 35);
}

.obj-row {
    flex-direction: row;
    align-items: flex-start;
    padding-top: 7px;
    padding-bottom: 7px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(16, 34, 30);
}

.obj-row-last {
    border-bottom-width: 0;
}

.obj-num {
    font-size: 9px;
    color: rgb(74, 155, 142);
    opacity: 0.55;
    width: 18px;
    flex-shrink: 0;
    padding-top: 2px;
    -unity-text-align: upper-left;
}

.obj-text {
    font-size: 11px;
    color: rgb(138, 171, 176);
    white-space: normal;
    -unity-text-align: upper-left;
    flex-grow: 1;
}

/* ── Context strip ───────────────────────────────────────────── */
.context-strip {
    flex-direction: row;
    padding: 11px 22px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(18, 38, 35);
}

.ctx-tag {
    flex: 1;
    flex-direction: column;
    align-items: center;
    padding: 7px 4px;
    background-color: rgb(12, 26, 24);
    border-width: 1px;
    border-color: rgb(24, 52, 46);
    border-radius: 2px;
    margin-right: 5px;
}

/* Note: :last-child not supported in USS — ctx-tag spacing handled via btn-group padding */

.ctx-label {
    font-size: 8px;
    color: rgb(61, 90, 96);
    letter-spacing: 1px;
    -unity-text-align: upper-center;
    margin-bottom: 3px;
}

.ctx-val {
    font-size: 11px;
    color: rgb(74, 155, 142);
    -unity-text-align: upper-center;
}

/* ── Buttons ─────────────────────────────────────────────────── */
.btn-group {
    flex-direction: column;
    padding: 13px 22px 15px 22px;
}

.btn {
    height: 46px;
    border-radius: 3px;
    margin-bottom: 7px;
    padding: 0;
}

/* Note: :last-child not supported in USS — zero out margin on the last button via a named class */
.btn-about-last {
    margin-bottom: 0;
}

.btn-inner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding-left: 15px;
    padding-right: 15px;
}

.btn-label {
    font-size: 13px;
    -unity-text-align: middle-left;
}

.btn-arrow {
    font-size: 14px;
    opacity: 0.5;
    -unity-text-align: middle-right;
}

/* Primary — Enter the ward */
.btn-primary {
    background-color: rgb(74, 155, 142);
    border-width: 1px;
    border-color: rgb(58, 128, 112);
}

.btn-primary:hover {
    background-color: rgb(82, 176, 160);
    border-color: rgb(74, 155, 142);
}

.btn-primary:active {
    background-color: rgb(58, 128, 112);
}

.btn-primary .btn-label {
    color: rgb(255, 255, 255);
}

.btn-primary .btn-arrow {
    color: rgb(255, 255, 255);
}

/* Secondary — About / Options */
.btn-secondary {
    background-color: rgba(0,0,0,0);
    border-width: 1px;
    border-color: rgb(24, 52, 46);
}

.btn-secondary:hover {
    background-color: rgb(15, 34, 30);
    border-color: rgb(74, 155, 142);
}

.btn-secondary .btn-label {
    color: rgb(138, 171, 176);
}

.btn-secondary .btn-arrow {
    color: rgb(138, 171, 176);
}

.btn-secondary:hover .btn-label {
    color: rgb(237, 242, 240);
}

/* ── Panel footer ────────────────────────────────────────────── */
.panel-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 9px 22px 13px 22px;
    border-top-width: 1px;
    border-top-color: rgb(18, 38, 35);
}

.panel-footer-text {
    font-size: 9px;
    color: rgb(138, 171, 176);
    letter-spacing: 0.8px;
    -unity-text-align: middle-left;
}

.panel-version {
    font-size: 9px;
    color: rgb(61, 90, 96);
    border-width: 1px;
    border-color: rgb(24, 52, 46);
    border-radius: 2px;
    padding: 2px 6px;
    -unity-text-align: middle-center;
}

/* ── ECG strip ──────────────────────────────────────────────── */
.ecg-strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    height: 40px;
    opacity: 0.22;
    /* Background image assigned at runtime by MainMenuController.cs */
}

/* ── Citation ────────────────────────────────────────────────── */
.citation {
    font-size: 9px;
    color: rgb(138, 171, 176);
    letter-spacing: 1.2px;
    -unity-text-align: lower-center;
    align-self: center;
    position: absolute;
    bottom: 10px;
    left: 0;
    right: 0;
}

/* ── Modal overlay ───────────────────────────────────────────── */
.modal-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(4, 9, 16, 0.75);
    align-items: center;
    justify-content: center;
    display: none;
}

.modal-overlay.visible {
    display: flex;
}

.modal-card {
    width: 540px;
    background-color: rgb(10, 20, 36);
    border-width: 1px;
    border-color: rgb(26, 55, 50);
    border-radius: 4px;
    flex-direction: column;
}

.modal-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 16px 22px 13px 22px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(20, 44, 40);
}

.modal-title {
    font-size: 15px;
    color: rgb(237, 242, 240);
    -unity-text-align: middle-left;
}

.modal-close {
    width: 28px;
    height: 28px;
    background-color: rgba(0,0,0,0);
    border-width: 1px;
    border-color: rgb(26, 55, 50);
    border-radius: 2px;
    color: rgb(138, 171, 176);
    font-size: 13px;
    -unity-text-align: middle-center;
    padding: 0;
}

.modal-close:hover {
    border-color: rgb(74, 155, 142);
    color: rgb(237, 242, 240);
    background-color: rgb(15, 34, 30);
}

.modal-body {
    font-size: 12px;
    color: rgb(138, 171, 176);
    white-space: normal;
    -unity-text-align: upper-left;
    padding: 18px 22px;
}

.modal-footer {
    padding: 0 22px 18px 22px;
    align-items: flex-end;
}

.modal-ok-btn {
    width: 120px;
    margin-bottom: 0;
}

/* ── Options scroll body ─────────────────────────────────────── */
.options-scroll-body {
    max-height: 460px;
    flex: 1;
}

/* ── Options modal: sections ─────────────────────────────────── */

.options-section {
    flex-direction: column;
    padding: 8px 22px 6px 22px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(20, 44, 40);
}

.options-section-last {
    border-bottom-width: 0;
}

.options-section-label {
    font-size: 8px;
    color: rgb(61, 90, 96);
    letter-spacing: 2px;
    -unity-text-align: upper-left;
    margin-bottom: 4px;
}

/* ── Options rows ────────────────────────────────────────────── */

/* Default row: label+desc on left, control on right (horizontal) */
.options-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* Stacked variant: title+desc on top, control below */
.options-row-col {
    flex-direction: column;
    align-items: stretch;
}

.options-row-text {
    flex-direction: column;
    flex: 1;
}

.options-row-title {
    font-size: 12px;
    color: rgb(237, 242, 240);
    -unity-text-align: upper-left;
    margin-bottom: 2px;
}

.options-row-desc {
    font-size: 10px;
    color: rgb(100, 138, 146);
    -unity-text-align: upper-left;
    white-space: normal;
}

/* ── Musophobia toggle ───────────────────────────────────────── */

/*
    Unity UI Toolkit Toggle consists of:
      .unity-toggle               — root row
      .unity-toggle__input        — the checkbox square
      .unity-toggle__checkmark    — the tick inside the checkbox
      .unity-toggle__label        — text label (hidden here — we use options-row-text instead)

    We hide the built-in label and style the checkbox to match the palette.
*/

.options-toggle {
    /* Remove the built-in left margin that normally aligns it with a label */
    margin-left: 0;
    margin-right: 0;
    flex-shrink: 0;
}

.options-toggle > .unity-toggle__input {
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background-color: rgb(24, 52, 46);
    border-width: 1px;
    border-color: rgb(40, 80, 72);
    /* Hide the default square checkmark — we use background-color swap for on/off */
    justify-content: center;
    align-items: center;
}

.options-toggle:checked > .unity-toggle__input {
    background-color: rgb(74, 155, 142);
    border-color: rgb(58, 128, 112);
}

.options-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    /* Pill thumb */
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(100, 138, 146);
    /* Suppress the default checkmark image */
    -unity-background-image-tint-color: rgba(0,0,0,0);
    position: relative;
    left: -6px;
}

.options-toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: rgb(255, 255, 255);
    left: 6px;
}

/* Hide the built-in text label — the UXML row provides its own */
.options-toggle > .unity-label {
    display: none;
}

/* ── Options selector button group ──────────────────────────
   Single shared class replaces the previous crosshair-btn,
   crosshairColour-btn, outline-btn, and tod-btn families.
   All selector groups use options-btn-group + options-btn.
   ─────────────────────────────────────────────────────────── */

.options-btn-group {
    flex-direction: row;
    margin-top: 6px;
    margin-bottom: 2px;
    flex-wrap: wrap;
}

.options-btn {
    height: 32px;
    padding: 0 12px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 3px;
    font-size: 11px;
    background-color: rgb(12, 26, 24);
    border-width: 1px;
    border-color: rgb(24, 52, 46);
    color: rgb(100, 138, 146);
    -unity-text-align: middle-center;
}

.options-btn:hover {
    background-color: rgb(18, 40, 36);
    border-color: rgb(74, 155, 142);
    color: rgb(237, 242, 240);
}

.options-btn.selected {
    background-color: rgb(74, 155, 142);
    border-color: rgb(58, 128, 112);
    color: rgb(255, 255, 255);
}

.options-btn.selected:hover {
    background-color: rgb(82, 176, 160);
}

/* ── Content warnings toggle row ────────────────────────────
   Rats and Snakes use standard options-row pattern.
   No additional classes needed.
   ─────────────────────────────────────────────────────────── */

/* Wrapper for the two nested phobia toggle rows */
.options-phobia-rows {
    flex-direction: column;
    margin-top: 4px;
    align-self: stretch;
}

/* Each phobia row — inherits options-row layout but tighter */
.options-phobia-row {
    padding-top: 3px;
    padding-bottom: 3px;
}
